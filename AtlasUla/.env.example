# ==========================================
# ATLASULA ENVIRONMENT VARIABLE TEMPLATE
# ==========================================

# 1. Gemini AI API Key
# Get a key from: https://ai.google.dev/
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Firebase App Credentials
# Create a web app in Firebase Console and paste config details below:
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# 3. Third-party integrations
VITE_WEATHER_API_KEY=YOUR_OPENWEATHER_KEY_HERE
VITE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY_HERE
